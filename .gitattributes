# Enforce LF line endings in the repository for text sources.
# `text=auto` lets Git normalize newly-committed/edited content to LF without
# retroactively flagging existing CRLF blobs (progressive convergence, no bulk
# renormalization). Only text extensions are listed so binaries/assets are never touched.
*.ts    text=auto eol=lf
*.js    text=auto eol=lf
*.css   text=auto eol=lf
*.scss  text=auto eol=lf
*.json  text=auto eol=lf
*.html  text=auto eol=lf
*.md    text=auto eol=lf

# Git LFS for assets — kept as-is.
src/assets/ filter=lfs diff=lfs merge=lfs -text
