# See http://help.github.com/ignore-files/ for more about ignoring files.

# Compiled output
/dist
/tmp
/out-tsc

# Node
/node_modules
# npm cache, kept inside the project dir so GitLab CI can cache it (see .gitlab-ci.yml)
.npm/
npm-debug.log

# IDEs and editors
.idea/
*.sublime-workspace
.history/*

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Miscellaneous
/.angular/cache
/coverage

# System files
.DS_Store
Thumbs.db

# NPM resource file
.npmrc

# Docusaurus
.docusaurus
docusaurus/build/*
docusaurus/node_modules/*

# Scoped translations copied from @sinequa/atomic-angular and @sinequa/assistant
# by `transloco-scoped-libs` (see transloco.config.ts), run from the npm postinstall.
# Allow-list, not deny-list: everything under src/assets/i18n/ is generated EXCEPT the
# app-owned scopes below, so a new scope published by a lib is ignored automatically.
# Only add an exception here when the app itself owns the translation files.
# The extractor is run with --skip-gitignore so it stops appending its own deny-list here.
/src/assets/i18n/*
!/src/assets/i18n/*.json
!/src/assets/i18n/article/
!/src/assets/i18n/preview/
!/src/assets/i18n/search-input/
!/src/assets/i18n/user-menu/

# Insight configuration
proxy.conf.insight.json
/src/environments/environment.insight.ts
