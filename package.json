{
  "name": "sinequa-mint",
  "version": "0.0.0",
  "scripts": {
    "build": "ng build",
    "docs:build": "cd docusaurus && npm run build",
    "docs:build-internal": "cd docusaurus && npm run build-internal",
    "docs:ci": "cd docusaurus && npm ci",
    "docs:start": "npm run start:docs",
    "lint": "ng lint",
    "ng": "ng",
    "prepare": "husky",
    "prettier:check": "prettier --config .prettierrc --check src/**/*.{js,ts,html,scss,css,json}",
    "prettier:write": "prettier --config .prettierrc --write src/**/*.{js,ts,html,scss,css,json}",
    "start": "ng serve --ssl=true --proxy-config=proxy.conf.json",
    "start:docs": "cd docusaurus && npm start",
    "start:local": "ng serve --ssl=true --proxy-config=proxy.conf.local.json",
    "test": "ng test",
    "up:atomic": "npm i @sinequa/atomic@latest @sinequa/atomic-angular@latest",
    "watch": "ng build --watch --configuration development"
  },
  "lint-staged": {
    "*.{js,ts,html,scss,css,json}": [
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular-architects/ngrx-toolkit": "^18.1.1",
    "@angular-eslint/schematics": "^18.3.1",
    "@angular-slider/ngx-slider": "^17.0.2",
    "@angular/animations": "^18.2.5",
    "@angular/cdk": "^18.2.14",
    "@angular/common": "^18.2.5",
    "@angular/compiler": "^18.2.5",
    "@angular/core": "^18.2.5",
    "@angular/forms": "^18.2.5",
    "@angular/platform-browser": "^18.2.5",
    "@angular/platform-browser-dynamic": "^18.2.5",
    "@angular/router": "^18.2.5",
    "@jsverse/transloco": "^7.4.2",
    "@jsverse/transloco-messageformat": "^7.0.1",
    "@microsoft/signalr": "^7.0.14",
    "@microsoft/teams-js": "^2.22.0",
    "@ngrx/signals": "^18.1.1",
    "@ngrx/store": "^18.1.1",
    "@popperjs/core": "^2.11.8",
    "@sinequa/assistant": "^3.7.3",
    "@sinequa/atomic": "^0.0.79",
    "@sinequa/atomic-angular": "^0.0.163",
    "@sinequa/components": "^11.12.1",
    "@sinequa/core": "^11.12.1",
    "@sinequa/ui": "^0.0.0",
    "@tanstack/angular-query-experimental": "^5.40.0",
    "@types/node": "^16.18.11",
    "atomicjs": "^4.4.1",
    "chart.js": "^4.4.3",
    "clsx": "^2.1.0",
    "d3-format": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "date-fns": "^2.29.3",
    "date-fns-tz": "^1.3.7",
    "diacritics": "^1.3.0",
    "element-resize-detector": "^1.2.4",
    "highlight-words": "^1.2.2",
    "intl": "^1.2.5",
    "intl-format-cache": "^4.3.1",
    "intl-messageformat": "^10.5.12",
    "intl-pluralrules": "^2.0.1",
    "js-polyfills": "^0.1.43",
    "js-sha256": "^0.11.0",
    "jssha": "^3.3.1",
    "keyux": "^0.8.2",
    "lodash": "^4.17.21",
    "matchmedia-polyfill": "^0.3.2",
    "ngx-bootstrap": "^8.0.0",
    "ngx-remark": "^0.0.6-ng14",
    "ngx-sonner": "^1.0.0",
    "prismjs": "^1.29.0",
    "prismjs-components-importer": "^0.2.0",
    "remark": "^14.0.3",
    "remark-gfm": "^3.0.1",
    "remark-parse": "^10.0.2",
    "rxjs": "~7.8.0",
    "safecolor": "^1.0.1",
