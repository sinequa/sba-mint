    "@angular/cli": "^18.2.5",
    "@angular/compiler-cli": "^18.2.5",
    "@floating-ui/dom": "^1.6.3",
    "@types/d3-format": "^3.0.4",
    "@types/d3-time": "^3.0.3",
    "@types/d3-time-format": "^4.0.3",
    "@types/unist": "^2.0.7",
    "autoprefixer": "^10.4.16",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "postcss": "^8.4.32",
    "prettier": "^3.4.2",
    "prettier-plugin-package": "^1.4.0",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "tailwind-merge": "^2.2.2",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.4.2",
    "zod": "^3.24.2"
  }
}
